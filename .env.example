# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny

# LLM Provider: 'cloud' (Anthropic) or 'local' (Ollama)
LLM_PROVIDER=local

# Required only when LLM_PROVIDER=cloud
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (used when LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
